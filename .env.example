# Agent Arena: OKX Agent Trade Kit integration
# Copy this file to `.env` and fill the values below.

# Public market base. Leave unchanged unless you need to proxy OKX.
OKX_AGENT_TRADE_BASE=https://www.okx.com

# Private account credentials for okx-cex-portfolio / okx-cex-trade
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Demo-first routing switch. Keep this true for the competition build.
OKX_DEMO_TRADING=true

# Agent Arena deployment split
# Set to `runtime` on your OpenClaw server, `web` on Vercel.
AGENT_ARENA_NODE_ROLE=web

# On Vercel/web, point this at the public origin of your OpenClaw runtime server.
# Example: https://arena-runtime.example.com
AGENT_ARENA_REMOTE_ORIGIN=

# Shared secret used by the web node to proxy Arena API calls and by cron to hit /api/agent-arena/admin/tick.
AGENT_ARENA_RUNNER_TOKEN=

# Only enable background runner on a dedicated long-lived server process.
# Keep false on Vercel. If you use cron-driven ticks on the runtime node, keep this false there too.
AGENT_ARENA_ENABLE_BACKGROUND_RUNNER=false

# Optional: extra OKX demo accounts for real copy-trade followers.
# Provide a JSON array. Each follower profile must be a separate demo account.
# Example:
# OKX_DEMO_FOLLOWER_PROFILES_JSON=[{"id":"follower-1","label":"Follower 1","apiKey":"...","secretKey":"...","passphrase":"...","demoTrading":true}]
OKX_DEMO_FOLLOWER_PROFILES_JSON=[]
